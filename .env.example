# Copy to .env (git-ignored) and fill in real values:
#   cp .env.example .env

DB_NAME=finance
DB_USERNAME=finance
DB_PASSWORD=change-me

# Used by `pnpm dev` / `pnpm migrate` when running the API outside Docker
# (must match the values above; Postgres is published on localhost:5432).
DATABASE_URL=postgres://finance:change-me@localhost:5432/finance

# Long random token for POST /api/ingest/sms. Generate with:
#   openssl rand -base64 48
INGEST_API_TOKEN=

LOG_LEVEL=info
